{
  "name": "polizeirat-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verwaltungsportal Polizeirat – Server mit Anmeldung und PostgreSQL",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "mysql:prepare": "node scripts/mysql/prepare.mjs",
    "mysql:copy": "node scripts/mysql/copy.mjs",
    "mysql:audit": "node scripts/mysql/audit-sql.mjs",
