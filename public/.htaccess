# Apache 2.4 / PHP 8.2+ — document root MUST be this public directory.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Preserve the exact public URLs used by the legacy Node server and
# OAuth/privacy links in public/index.html.
RewriteRule ^start/?$ start.html [L]
RewriteRule ^datenschutz/?$ datenschutz.html [L]
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]
<FilesMatch "^(?:\.htaccess|\.env|composer\.(?:json|lock))$">
  Require all denied
</FilesMatch>
# Oberfläche immer neu validieren (ETag), damit neue Module/Rechte ohne Cache-Leeren sichtbar sind.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
