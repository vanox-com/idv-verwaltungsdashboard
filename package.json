  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "pg": "^8.13.1",
    "jszip": "^3.10.1",
    "mysql2": "^3.15.0"
